<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IntermediateOutputPathSuffix>signfontcatalogdiagnostic\</IntermediateOutputPathSuffix>
  </PropertyGroup>

  <Import Project="SetupProjectBefore.settings" />
  <Import Project="$(TargetsPath)\Common.Shim.targets" />

  <PropertyGroup>
    <OutputPath>$(TemplateFontVerificationPath)\</OutputPath>
    <OutDir>$(TemplateFontVerificationPath)\</OutDir>
    <DjangoTemplateFontPath>$(TemplateFontVerificationPath)\Microsoft.PythonTools.Django.Templates-0.ttf</DjangoTemplateFontPath>
    <WebTemplateFont0Path>$(TemplateFontVerificationPath)\Microsoft.PythonTools.Web.Templates-0.ttf</WebTemplateFont0Path>
    <WebTemplateFont1Path>$(TemplateFontVerificationPath)\Microsoft.PythonTools.Web.Templates-1.ttf</WebTemplateFont1Path>
    <WebTemplateFont2Path>$(TemplateFontVerificationPath)\Microsoft.PythonTools.Web.Templates-2.ttf</WebTemplateFont2Path>
    <TemplateFontCatalogPath>$(TemplateFontVerificationPath)\PTVS-TemplateFontCatalog.cat</TemplateFontCatalogPath>
    <TemplateFontCatalogCdfPath>$(IntermediateOutputPath)PTVS-TemplateFontCatalog.cdf</TemplateFontCatalogCdfPath>
    <TemplateFontCatalogUnsignedPath>$(IntermediateOutputPath)PTVS-TemplateFontCatalog.unsigned.cat</TemplateFontCatalogUnsignedPath>
    <TemplateFontOriginalPath Condition="'$(TemplateFontOriginalPath)' == ''">$(IntermediateOutputPath)original-fonts</TemplateFontOriginalPath>
    <WindowsKitsRoot Condition="'$(WindowsKitsRoot)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', null, RegistryView.Registry32, RegistryView.Default))</WindowsKitsRoot>
    <MakeCatExe Condition="'$(MakeCatExe)' == '' and '$(WindowsSdkVerBinPath)' != '' and Exists('$(WindowsSdkVerBinPath)x86\makecat.exe')">$(WindowsSdkVerBinPath)x86\makecat.exe</MakeCatExe>
    <MakeCatExe Condition="'$(MakeCatExe)' == '' and '$(WindowsKitsRoot)' != '' and '$(TargetPlatformSdkVersion)' != '' and Exists('$(WindowsKitsRoot)bin\$(TargetPlatformSdkVersion)\x86\makecat.exe')">$(WindowsKitsRoot)bin\$(TargetPlatformSdkVersion)\x86\makecat.exe</MakeCatExe>
    <MakeCatExe Condition="'$(MakeCatExe)' == '' and '$(WindowsKitsRoot)' != '' and Exists('$(WindowsKitsRoot)bin\10.0.26100.0\x86\makecat.exe')">$(WindowsKitsRoot)bin\10.0.26100.0\x86\makecat.exe</MakeCatExe>
    <MakeCatExe Condition="'$(MakeCatExe)' == ''">makecat.exe</MakeCatExe>
  </PropertyGroup>

  <ItemGroup>
    <TemplateFontFiles Include="$(DjangoTemplateFontPath);$(WebTemplateFont0Path);$(WebTemplateFont1Path);$(WebTemplateFont2Path)" />

    <FilesToSign Include="$(TemplateFontCatalogPath)">
      <Authenticode>Microsoft400</Authenticode>
      <SignedPath>$(TemplateFontCatalogPath)</SignedPath>
      <UnsignedPath>$(TemplateFontCatalogUnsignedPath)</UnsignedPath>
    </FilesToSign>
  </ItemGroup>

  <Target Name="_ValidateTemplateFontInputs">
    <Error Condition="'$(TemplateFontVerificationPath)' == ''" Text="TemplateFontVerificationPath is required." />
    <Error Condition="!Exists('$(TemplateFontVerificationPath)')" Text="TemplateFontVerificationPath '$([System.IO.Path]::GetFullPath('$(TemplateFontVerificationPath)'))' does not exist." />
    <Error Condition="!Exists('$(DjangoTemplateFontPath)')" Text="Missing template font '$([System.IO.Path]::GetFileName('$(DjangoTemplateFontPath)'))' in '$(TemplateFontVerificationPath)'." />
    <Error Condition="!Exists('$(WebTemplateFont0Path)')" Text="Missing template font '$([System.IO.Path]::GetFileName('$(WebTemplateFont0Path)'))' in '$(TemplateFontVerificationPath)'." />
    <Error Condition="!Exists('$(WebTemplateFont1Path)')" Text="Missing template font '$([System.IO.Path]::GetFileName('$(WebTemplateFont1Path)'))' in '$(TemplateFontVerificationPath)'." />
    <Error Condition="!Exists('$(WebTemplateFont2Path)')" Text="Missing template font '$([System.IO.Path]::GetFileName('$(WebTemplateFont2Path)'))' in '$(TemplateFontVerificationPath)'." />
    <ItemGroup>
      <_ActualTemplateFonts Include="$(TemplateFontVerificationPath)\*.ttf" />
    </ItemGroup>
    <Error Condition="'@(_ActualTemplateFonts->Count())' != '4'" Text="Expected exactly four packaged template fonts." />
    <Error Condition="'$(MakeCatExe)' != 'makecat.exe' and !Exists('$(MakeCatExe)')" Text="makecat.exe was not found at '$(MakeCatExe)'." />
  </Target>

  <Target Name="_GenerateTemplateFontCatalog"
          DependsOnTargets="_ValidateTemplateFontInputs"
          BeforeTargets="_PreserveUnsigned;ListFiles;SignFiles">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <MakeDir Directories="$(TemplateFontOriginalPath)" />
    <Copy SourceFiles="@(TemplateFontFiles)" DestinationFolder="$(TemplateFontOriginalPath)" />
    <Delete Files="$(TemplateFontCatalogPath);$(TemplateFontCatalogCdfPath);$(TemplateFontCatalogUnsignedPath)" />

    <WriteLinesToFile File="$(TemplateFontCatalogCdfPath)" Lines="[CatalogHeader]" Overwrite="true" Encoding="ASCII" />
    <WriteLinesToFile File="$(TemplateFontCatalogCdfPath)" Lines="Name=$([System.IO.Path]::GetFileName('$(TemplateFontCatalogPath)'));ResultDir=$([System.IO.Path]::GetDirectoryName('$(TemplateFontCatalogPath)'));CatalogVersion=2;HashAlgorithms=SHA256;;[CatalogFiles]" Overwrite="false" Encoding="ASCII" />
    <WriteLinesToFile File="$(TemplateFontCatalogCdfPath)"
                      Lines="@(TemplateFontFiles->'&lt;hash&gt;%(Filename)=%(FullPath)')"
                      Overwrite="false"
                      Encoding="ASCII" />
    <Message Importance="high" Text="Generating template font catalog $(TemplateFontCatalogPath) for @(TemplateFontFiles->'%(FullPath)', ', ')" />
    <Exec Command="&quot;$(MakeCatExe)&quot; &quot;$(TemplateFontCatalogCdfPath)&quot;" StandardOutputImportance="High" />
  </Target>

  <Target Name="_PreserveUnsigned" Inputs="%(FilesToSign.FullPath)" Outputs="%(FilesToSign.UnsignedPath)" BeforeTargets="SignFiles">
    <Copy SourceFiles="%(FilesToSign.FullPath)" DestinationFiles="%(FilesToSign.UnsignedPath)" />
  </Target>

  <Target Name="ListFiles">
    <Message Text="OutputPath: $(OutputPath)" Importance="high" />
    <Message Text="@(FilesToSign->'%(Identity) (%(Authenticode)) - %(SignedPath)', '
')" Importance="high" />
  </Target>

  <Import Project="$(TargetsPath)\MicroBuild.targets" />
</Project>
